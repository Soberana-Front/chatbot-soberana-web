    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "8.3.0",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
