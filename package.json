{
  "name": "soberana-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "api:types": "openapi-typescript ${VITE_API_OPENAPI_URL:-http://localhost:8081/api/docs/json} -o src/api/generated/schema.d.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write package.json eslint.config.js .prettierrc.json vite.config.ts tests/setup.ts tests/Button.test.tsx",
    "format:check": "prettier package.json eslint.config.js .prettierrc.json vite.config.ts tests/setup.ts tests/Button.test.tsx --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@types/react-router-dom": "5.3.3",
    "axios": "1.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "8.3.0",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv-cli": "11.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.2.1",
    "vitest": "5.1.0"
  }
}
